#lang racket
(require rackunit
         cpsc411/langs/v2
         (only-in "../asm-lang/assign-homes.rkt" assign-homes))

(define (check-asm-lang-v2 p)
  (if (asm-lang-v2? p) p #f))

(define (check-nested-asm-lang-v2 p)
  (if (nested-asm-lang-v2? p) p #f))

(define-syntax-rule (check-by-interp p)
  (check-equal? (interp-nested-asm-lang-v2 (check-nested-asm-lang-v2 (assign-homes p)))
                (interp-asm-lang-v2 (check-asm-lang-v2 p))))

