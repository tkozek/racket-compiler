(define (check-input p)
  (if (paren-x64-v6? p)
      p
      (error (~a (pretty-format p) "\n is not a semantically valid " "paren-x64-v6?" " program"))))

(define (check-output p)
  p)

(define-syntax-rule (check-by-interp p)
  (check-equal? (execute (check-output (generate-x64 p))) (interp-paren-x64-v6 (check-input p))))

(define (test-success fun case)
  (check-equal? (fun case) case))
(define (test-fail fun case)
  (check-exn exn:fail? (λ () (fun case))))
